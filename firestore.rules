rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isOwnUser(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == "admin";
    }

    function isTouristOwner(userId) {
      return isOwnUser(userId) || isAdmin();
    }

    function isValidCoordinate(latitude, longitude) {
      return latitude is number
        && longitude is number
        && latitude >= -90
        && latitude <= 90
        && longitude >= -180
        && longitude <= 180;
    }

    match /users/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow create: if isOwnUser(userId)
        && request.resource.data.role == "tourist"
        && request.resource.data.authUid == request.auth.uid;
      allow update: if isOwnUser(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.authUid == request.auth.uid;
      allow delete: if false;
    }

    match /consents/{consentId} {
      allow read: if isTouristOwner(resource.data.userId);
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.granted is bool;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if isTouristOwner(resource.data.userId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ["active", "completed"];
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /movementPoints/{pointId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/trips/$(resource.data.tripId))
          && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.userId == request.auth.uid
        );
      allow create: if signedIn()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId))
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || (
            exists(/databases/$(database)/documents/trips/$(resource.data.tripId))
            && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.userId == request.auth.uid
          )
        );
    }

    match /destinations/{destinationId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude);
      allow delete: if isAdmin();
    }

    match /analyses/{analysisId} {
      allow read: if isTouristOwner(resource.data.userId);
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /recommendations/{recommendationId} {
      allow read: if isTouristOwner(resource.data.userId);
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
  }
}

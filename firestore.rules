rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isOwnUser(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == "admin";
    }

    function ownsAuthBackedUser() {
      return signedIn()
        && (
          request.resource.data.authUid == request.auth.uid
          || request.resource.data.userId == request.auth.uid
          || request.resource.data.id == request.auth.uid
        );
    }

    function ownsExistingRecord() {
      return signedIn()
        && (
          resource.data.authUid == request.auth.uid
          || resource.data.userId == request.auth.uid
          || resource.data.id == request.auth.uid
        );
    }

    function ownsRequestedRecord() {
      return signedIn()
        && (
          request.resource.data.authUid == request.auth.uid
          || request.resource.data.userId == request.auth.uid
          || request.resource.data.id == request.auth.uid
        );
    }

    function isValidCoordinate(latitude, longitude) {
      return latitude is number
        && longitude is number
        && latitude >= -90
        && latitude <= 90
        && longitude >= -180
        && longitude <= 180;
    }

    function canReadOwnedRecord() {
      return isAdmin() || ownsExistingRecord();
    }

    function canCreateOwnedRecord() {
      return isAdmin() || ownsRequestedRecord();
    }

    function canUpdateOwnedRecord() {
      return isAdmin() || (ownsExistingRecord() && ownsRequestedRecord());
    }

    match /users/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow create: if isAdmin()
        || (
          isOwnUser(userId)
          && request.resource.data.role == "tourist"
          && request.resource.data.authUid == request.auth.uid
        );
      allow update: if isAdmin()
        || (
          isOwnUser(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.authUid == request.auth.uid
        );
      allow delete: if false;
    }

    match /tourist_profiles/{profileId} {
      allow read: if isAdmin() || ownsExistingRecord() || isOwnUser(profileId);
      allow create, update: if isAdmin() || ownsAuthBackedUser() || isOwnUser(profileId);
      allow delete: if false;
    }

    match /tourist_preferences/{preferenceId} {
      allow read: if isAdmin() || ownsExistingRecord() || isOwnUser(preferenceId);
      allow create, update: if isAdmin() || ownsAuthBackedUser() || isOwnUser(preferenceId);
      allow delete: if false;
    }

    match /location_consents/{consentId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord() && request.resource.data.granted is bool;
      allow update: if canUpdateOwnedRecord() && request.resource.data.granted is bool;
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /trip_sessions/{tripId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.status in ["active", "completed"];
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.status in ["active", "completed"];
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /movement_records/{pointId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.tripId is string;
      allow update: if canUpdateOwnedRecord()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.tripId is string;
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /destination_categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude);
      allow delete: if isAdmin();
    }

    match /ai_analyses/{analysisId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord();
      allow update: if canUpdateOwnedRecord();
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /recommendations/{recommendationId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord();
      allow update: if canUpdateOwnedRecord();
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /sos_alerts/{alertId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.status in ["open", "reviewing", "resolved"];
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.status in ["open", "reviewing", "resolved"];
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /incident_reports/{reportId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.status in ["open", "reviewing", "resolved"]
        && request.resource.data.type in ["lost-item", "accident", "suspicious-activity", "medical", "other"];
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.status in ["open", "reviewing", "resolved"]
        && request.resource.data.type in ["lost-item", "accident", "suspicious-activity", "medical", "other"];
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /attraction_checkins/{checkInId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.destinationId is string
        && request.resource.data.status in ["checked-in", "checked-out"];
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.destinationId is string
        && request.resource.data.status in ["checked-in", "checked-out"];
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /geofences/{geofenceId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.type in ["safe", "restricted", "dense"];
      allow delete: if isAdmin();
    }

    match /consents/{consentId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord() && request.resource.data.granted is bool;
      allow update: if canUpdateOwnedRecord() && request.resource.data.granted is bool;
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /trips/{tripId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.status in ["active", "completed"];
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.status in ["active", "completed"];
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /movementPoints/{pointId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.tripId is string;
      allow update: if canUpdateOwnedRecord()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.tripId is string;
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /analyses/{analysisId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord();
      allow update: if canUpdateOwnedRecord();
      allow delete: if isAdmin() || ownsExistingRecord();
    }
  }
}

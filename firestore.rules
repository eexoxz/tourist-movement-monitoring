rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isOwnUser(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == "admin";
    }

    function ownsRecord(data) {
      return signedIn()
        && data.get("userId", data.get("authUid", data.get("id", null))) == request.auth.uid
        && data.get("authUid", request.auth.uid) == request.auth.uid;
    }

    function ownsExistingRecord() {
      return ownsRecord(resource.data);
    }

    function ownsRequestedRecord() {
      return ownsRecord(request.resource.data);
    }

    function isValidCoordinate(latitude, longitude) {
      return latitude is number
        && longitude is number
        && latitude >= -90
        && latitude <= 90
        && longitude >= -180
        && longitude <= 180;
    }

    function canReadOwnedRecord() {
      return isAdmin() || ownsExistingRecord();
    }

    function canCreateOwnedRecord() {
      return isAdmin() || ownsRequestedRecord();
    }

    function canUpdateOwnedRecord() {
      return isAdmin() || (ownsExistingRecord() && ownsRequestedRecord()
        && request.resource.data.get("userId", null) == resource.data.get("userId", null)
        && request.resource.data.get("authUid", null) == resource.data.get("authUid", null)
        && request.resource.data.get("id", null) == resource.data.get("id", null));
    }

    function validItinerary(data, itineraryId) {
      return data.keys().hasAll(["id", "userId", "title", "startDate", "days", "notes", "stops", "revision", "deletedAt", "createdAt", "updatedAt"])
        && data.keys().hasOnly(["id", "userId", "title", "startDate", "days", "notes", "stops", "revision", "deletedAt", "createdAt", "updatedAt"])
        && data.id == itineraryId && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.startDate is string && (data.startDate == "" || data.startDate.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}"))
        && data.days is int && data.days >= 1 && data.days <= 14
        && data.notes is string && data.notes.size() <= 1000
        && data.stops is list && data.stops.size() <= 40
        && data.revision is int && data.revision >= 1
        && data.deletedAt is string && data.deletedAt.size() <= 40
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    match /tourist_itineraries/{itineraryId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/tourist_itineraries/$(itineraryId)) || ownsExistingRecord());
      allow list: if ownsExistingRecord();
      allow create: if signedIn() && validItinerary(request.resource.data, itineraryId) && request.resource.data.revision == 1;
      allow update: if ownsExistingRecord() && validItinerary(request.resource.data, itineraryId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.deletedAt == ""
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow create: if isAdmin()
        || (
          isOwnUser(userId)
          && request.resource.data.id == userId
          && request.resource.data.get("userId", userId) == userId
          && request.resource.data.role == "tourist"
          && request.resource.data.authUid == request.auth.uid
        );
      allow update: if isAdmin()
        || (
          isOwnUser(userId)
          && request.resource.data.id == userId
          && request.resource.data.get("userId", userId) == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.authUid == request.auth.uid
        );
      allow delete: if false;
    }

    match /tourist_profiles/{profileId} {
      allow read: if isAdmin() || isOwnUser(profileId);
      allow create: if isAdmin() || (isOwnUser(profileId) && ownsRequestedRecord()
        && request.resource.data.get("role", "tourist") == "tourist");
      allow update: if isAdmin() || (isOwnUser(profileId) && canUpdateOwnedRecord()
        && request.resource.data.get("role", "tourist") == "tourist");
      allow delete: if false;
    }

    match /tourist_preferences/{preferenceId} {
      allow read: if isAdmin() || isOwnUser(preferenceId);
      allow create: if isAdmin() || (isOwnUser(preferenceId) && ownsRequestedRecord()
        && request.resource.data.get("role", "tourist") == "tourist");
      allow update: if isAdmin() || (isOwnUser(preferenceId) && canUpdateOwnedRecord()
        && request.resource.data.get("role", "tourist") == "tourist");
      allow delete: if false;
    }

    match /location_consents/{consentId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord() && request.resource.data.granted is bool;
      allow update: if canUpdateOwnedRecord() && request.resource.data.granted is bool;
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /trip_sessions/{tripId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.status in ["active", "completed"];
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.status in ["active", "completed"];
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /movement_records/{pointId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.tripId is string;
      allow update: if canUpdateOwnedRecord()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.tripId is string;
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /destination_categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude);
      allow delete: if isAdmin();
    }

    match /ai_analyses/{analysisId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord();
      allow update: if canUpdateOwnedRecord();
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /recommendations/{recommendationId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord();
      allow update: if canUpdateOwnedRecord();
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /sos_alerts/{alertId} {
      allow get: if signedIn() && !exists(/databases/$(database)/documents/sos_alerts/$(alertId));
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.status in ["open", "reviewing", "resolved"];
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.status in ["open", "reviewing", "resolved"]
        && request.resource.data.userId == resource.data.userId
        && (isAdmin() || request.resource.data.get("adminNote", null) == resource.data.get("adminNote", null))
        && (resource.data.status != "resolved" || (
          request.resource.data.status == "resolved"
          && request.resource.data.get("closureReason", null) == resource.data.get("closureReason", null)
          && request.resource.data.get("closedBy", null) == resource.data.get("closedBy", null)
          && request.resource.data.get("resolvedAt", null) == resource.data.get("resolvedAt", null)
        ));
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /incident_reports/{reportId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.status in ["open", "reviewing", "resolved"]
        && request.resource.data.type in ["lost-item", "accident", "suspicious-activity", "medical", "other"];
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.status in ["open", "reviewing", "resolved"]
        && request.resource.data.type in ["lost-item", "accident", "suspicious-activity", "medical", "other"];
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /attraction_checkins/{checkInId} {
      allow get: if signedIn() && !exists(/databases/$(database)/documents/attraction_checkins/$(checkInId));
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.destinationId is string
        && request.resource.data.status in ["checked-in", "checked-out"]
        && (isAdmin() || (
          !request.resource.data.keys().hasAny(["reviewedBy", "reviewedAt"])
          && !request.resource.data.keys().hasAny(["isDemo"])
          && (!request.resource.data.keys().hasAny(["submittedPlace"])
            ? !request.resource.data.keys().hasAny(["reviewStatus"])
            : (request.resource.data.destinationId == ""
              && request.resource.data.reviewStatus == "pending"
              && request.resource.data.submittedPlace is map
              && request.resource.data.submittedPlace.name is string
              && request.resource.data.submittedPlace.name.size() >= 2
              && request.resource.data.submittedPlace.name.size() <= 100
              && request.resource.data.submittedPlace.address is string
              && request.resource.data.submittedPlace.address.size() <= 300
              && request.resource.data.submittedPlace.city is string
              && request.resource.data.submittedPlace.city.size() <= 80
              && request.resource.data.submittedPlace.note is string
              && request.resource.data.submittedPlace.note.size() <= 500
              && (!request.resource.data.submittedPlace.keys().hasAny(["state"]) || request.resource.data.submittedPlace.state in ["Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan", "Pahang", "Penang", "Perak", "Perlis", "Sabah", "Sarawak", "Selangor", "Terengganu", "Federal Territories"])
              && request.resource.data.submittedPlace.category in ["cultural", "nature", "urban", "heritage", "food", "coastal"]
              && (request.resource.data.keys().hasAll(["latitude", "longitude"])
                ? isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
                : (!request.resource.data.keys().hasAny(["latitude", "longitude"])
                  && request.resource.data.submittedPlace.address.size() >= 8
                  && request.resource.data.submittedPlace.city.size() >= 2
                  && request.resource.data.submittedPlace.keys().hasAny(["state"])))))
        ));
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.destinationId is string
        && request.resource.data.status in ["checked-in", "checked-out"]
        && (isAdmin() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "checkedOutAt"])
          && (resource.data.status != "checked-out" || request.resource.data.status == "checked-out")
        ));
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /geofences/{geofenceId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.type in ["safe", "restricted", "dense"];
      allow delete: if isAdmin();
    }

    match /consents/{consentId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord() && request.resource.data.granted is bool;
      allow update: if canUpdateOwnedRecord() && request.resource.data.granted is bool;
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /trips/{tripId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && request.resource.data.status in ["active", "completed"];
      allow update: if canUpdateOwnedRecord()
        && request.resource.data.status in ["active", "completed"];
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /movementPoints/{pointId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.tripId is string;
      allow update: if canUpdateOwnedRecord()
        && isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.tripId is string;
      allow delete: if isAdmin() || ownsExistingRecord();
    }

    match /analyses/{analysisId} {
      allow read: if canReadOwnedRecord();
      allow create: if canCreateOwnedRecord();
      allow update: if canUpdateOwnedRecord();
      allow delete: if isAdmin() || ownsExistingRecord();
    }
  }
}
